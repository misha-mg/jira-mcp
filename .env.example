# Scoped Jira API token. Real values belong in .env, never in git.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: obtained from the site's /_edge/tenant_info when omitted.
JIRA_CLOUD_ID=
# Optional override. Default: $XDG_CACHE_HOME/jira-mcp or ~/.cache/jira-mcp.
# Relative overrides resolve against this env file's folder (or cwd without it).
# JIRA_ATTACHMENT_DIR=/absolute/path/to/jira-attachments
# Start real testing in read-only mode; change to false to enable write tools.
JIRA_READ_ONLY=true
# Optional shared session identifier; empty creates a new one per process.
JIRA_SESSION_ID=
JIRA_MAX_FILE_BYTES=536870912
JIRA_MAX_CALL_BYTES=1073741824
# Ordinary Jira API requests, including response bodies.
JIRA_TIMEOUT_MS=30000
# Separate HTTP download deadlines: total per file and no incoming data.
JIRA_DOWNLOAD_TIMEOUT_MS=600000
JIRA_DOWNLOAD_IDLE_TIMEOUT_MS=30000
# TAR.GZ: actual expanded TAR stream bytes per call (including metadata/padding).
JIRA_MAX_EXTRACTED_BYTES=1073741824
JIRA_MAX_ARCHIVE_ENTRIES=20000
# Video previews: requires an up-to-date FFmpeg installation (ffmpeg + ffprobe)
# on the MCP host. Agents only need access to the generated JPEG files.
# JIRA_VIDEO_FRAMES=true
# Optional absolute executable paths when the MCP client's PATH omits them.
# JIRA_FFMPEG_PATH=/absolute/path/to/ffmpeg
# JIRA_FFPROBE_PATH=/absolute/path/to/ffprobe
