{
  "name": "@misha_m.g/jira-mcp",
  "version": "0.1.0",
  "description": "Small local Jira Cloud MCP server with on-disk attachments",
  "type": "module",
  "bin": {
    "jira-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify": "npm run check && npm test && npm run build",
    "prepack": "npm run build",
    "smoke": "tsx scripts/smoke.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "js-tiktoken": "^1.0.21",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misha-mg/jira-mcp.git"
  },
  "homepage": "https://github.com/misha-mg/jira-mcp#readme",
  "bugs": {
    "url": "https://github.com/misha-mg/jira-mcp/issues"
  },
  "keywords": [
    "jira",
    "mcp",
    "model-context-protocol",
    "claude",
    "attachments"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
